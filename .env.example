# Copie este arquivo para .env.local e substitua pelo valor da sua chave.
# EXPO_PUBLIC_ é visível no aplicativo compilado; restrinja a chave no Google Cloud.
EXPO_PUBLIC_GOOGLE_BOOKS_API_KEY=cole_sua_chave_aqui

# Endereço do backend Node local; no celular físico, use o IP local do computador.
EXPO_PUBLIC_API_URL=http://0.0.0.0:3333
